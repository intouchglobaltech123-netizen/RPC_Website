# Leak Doctor (AI chat, components/leakbot): copy to .env.local and fill in.

# Required: a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: the Gemini model to try first. Whether set or not, if a model is
# overloaded or slow the chat moves straight on to gemini-3.5-flash-lite,
# gemini-3.5-flash, gemini-3.1-flash-lite, gemini-3.8-flash and
# gemini-flash-latest in turn. Leave empty for the fastest.
GEMINI_MODEL=

# Optional: the daily allowance per visitor IP (resets at midnight IST).
LEAKBOT_PHOTOS_PER_DAY=5
LEAKBOT_MESSAGES_PER_DAY=30

# Optional: any random string; IPs are kept only as a hash salted with it.
LEAKBOT_SALT=

# Optional, needed on serverless hosting (Vercel etc.): Upstash Redis keeps the
# daily counts. Without it, counts live in the server's memory, which is fine
# for one always-on server (npm start) but resets when it restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
